# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env)
# บน Render ให้ตั้งค่าเหล่านี้ใน Dashboard > Environment แทน

PORT=3000
NODE_ENV=development
FRONTEND_URL=https://internship.evc.ac.th

# Google Sheets / Drive
SPREADSHEET_ID=
DRIVE_FOLDER_ID=
# JSON ของ Service Account ทั้งก้อน (บรรทัดเดียว) — ถ้าไม่ตั้ง จะอ่านจาก credentials/service-account-key.json
GOOGLE_CREDENTIALS=
# ไฟล์ต่อไปนี้ไม่ใช่ env — Local วางใน credentials/ ส่วน Render อัปโหลดเป็น Secret Files (/etc/secrets):
#   oauth-credentials.json, token.json, token_line.txt, channelID_line.txt, userID_line.txt

# Admin (จำเป็นต้องตั้ง — ระบบจะไม่ใช้ค่า default)
ADMIN_USERNAME=
ADMIN_PASSWORD=
# สร้างด้วย: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Email (Gmail App Password)
EMAIL_USER=
EMAIL_PASSWORD=
ADMIN_EMAILS=
